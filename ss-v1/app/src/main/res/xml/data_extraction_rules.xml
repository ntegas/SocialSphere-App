<?xml version="1.0" encoding="utf-8"?>
<!-- Аудит 2026-07-02: PII (вся БД CRM) НЕ покидает устройство ни облачным
     бэкапом, ни device-to-device переносом. allowBackup=false — основной
     барьер; здесь явные exclude как страховка (шаблон-заглушка удалён). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
