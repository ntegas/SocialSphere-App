# Release signing template. Copy to keystore.properties (git-ignored) and fill in.
# NEVER commit keystore.properties or any .jks / .keystore file.
# Create a key with:
#   keytool -genkey -v -keystore socialsphere-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias socialsphere
storeFile=../socialsphere-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=socialsphere
keyPassword=YOUR_KEY_PASSWORD
